<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <script>
        // Force scroll to top on page load/refresh
        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }
        window.addEventListener('beforeunload', function() {
            window.scrollTo(0, 0);
        });
        window.scrollTo(0, 0);
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
    <style>
        body { 
            padding-top: 2rem; 
            padding-bottom: 2rem;
            background: #ffffff;
            min-height: 100vh;
        }
        
        .chart-container { 
            margin-bottom: 2rem;
            width: 100%;
        }
        
        .chart-container .card {
            width: 100%;
            border: 2px solid #000000;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            background: #ffffff;
            overflow: hidden;
        }
        
        .chart-container .card-header {
            background: #000000;
            color: #ffffff;
            border-radius: 8px 8px 0 0 !important;
            font-weight: bold;
            padding: 1.5rem;
            border-bottom: 2px solid #000000;
        }
        
        .chart-container .card-body {
            padding: 2rem;
            overflow: visible;
            background: #ffffff;
        }
        
        #chart {
            width: 100% !important;
            display: block !important;
            border-radius: 10px;
            padding: 1rem;
            background: #ffffff;
        }
        
        .upload-container { 
            max-width: 600px; 
            margin: 0 auto 2rem auto;
            padding: 2.5rem;
            background: #ffffff;
            border: 2px solid #000000;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
        }
        
        .upload-container .btn-primary {
            background: #000000;
            border: 2px solid #000000;
            color: #ffffff;
            padding: 0.8rem 2.5rem;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            border-radius: 5px;
        }
        
        .upload-container .btn-primary:hover {
            background: #333333;
            border-color: #333333;
        }
        
        .container {
            max-width: 1400px;
        }
        
        .form-label {
            font-weight: 700;
            color: #000000;
        }
        
        .form-control, .form-select {
            border: 2px solid #000000;
            border-radius: 5px;
            padding: 0.75rem;
            transition: all 0.3s ease;
            background: #ffffff;
        }
        
        .form-control:focus, .form-select:focus {
            border-color: #000000;
            box-shadow: 0 0 0 0.2rem rgba(0, 0, 0, 0.1);
        }
        
        header {
            text-align: center;
            margin-bottom: 2rem;
            padding: 2rem;
            background: #ffffff;
            border: 2px solid #000000;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        
        header h1 {
            font-size: 3rem;
            font-weight: 900;
            color: #000000;
            margin-bottom: 1rem;
        }
        
        header .lead {
            font-size: 1.3rem;
            color: #000000;
            font-weight: 500;
        }
        
        .text-white-50 {
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="text-center mb-5">
            <h1>{{title}}</h1>
            <p class="lead">Upload your CSV file to visualize CVM analysis data</p>
        </header>

        <main>
            {{{body}}}
        </main>

        <footer class="text-center mt-5">
            <p style="font-weight: 600; font-size: 1.1rem;">
                <span style="color: #000000;">Made By - </span>
                <span style="color: #ffffff; font-weight: 800; background: #000000; padding: 0.3rem 0.8rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);">Jinesh Kothari</span>
            </p>
            <p style="color: #000000; font-size: 0.9rem;">
                EasyGo Visualizer &copy; 2025
            </p>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
